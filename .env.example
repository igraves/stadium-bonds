# Copy to .env and fill in. Nothing here is required for local development —
# the API and web app run with these unset.

# --- api/ (Fastify) ---
# Port and host the local API server binds to.
PORT=3000
HOST=0.0.0.0
# Fastify log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Allowed CORS origin. Defaults to * when unset.
CORS_ORIGIN=http://localhost:5173
# Set by `npm run dev -w api`; mounts routes under /api to match the
# deployed API Gateway stage. Leave unset when running the Lambda bundle.
LOCAL_DEV=true
# Verified SES identity used as both sender and recipient for the
# /feedback endpoint. When unset, feedback submissions return an error.
FEEDBACK_EMAIL=

# --- infra/ (AWS CDK) ---
# All optional; each can also be passed as `cdk deploy -c <name>=<value>`.
# Custom domain for the CloudFront distribution.
DOMAIN_NAME=
# Route 53 hosted zone for DOMAIN_NAME.
HOSTED_ZONE_ID=
# ACM certificate ARN. Must be issued in us-east-1 for CloudFront.
CERTIFICATE_ARN=
# Target account and region. Region defaults to us-east-2.
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=us-east-2
